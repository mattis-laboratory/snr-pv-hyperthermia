%% Spearman correlation of time vs. moving average amp and freq
%[rho, pVal] = corr([1:length(metric_pre_mean)]',metric_pre_mean',"type","Spearman","tail","both");




%% Embedded function - truncated average

function [metric_mean, metric_sem] = get_avg_trace(metric, n_mice)

% Truncate all moving averages to shortest signal
minLen           = min(cellfun(@length,  metric(:,1)));
truncAvg         = cell2mat(cellfun(@(v) v(1:minLen),  ...
                   metric(:,1), 'UniformOutput', false));
% Get mean and SEM
metric_mean      = flip(nanmean(truncAvg, 1));
metric_sem       = flip(nanstd(truncAvg, 1)/sqrt(n_mice));
end
