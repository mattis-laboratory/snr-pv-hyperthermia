%% Plot moving averages from all groups (overlaid)
clear; close all

params  = transients_params();

groups = {'WT_nsz','het_nsz','het_sz'};

for g = 1:length(groups)
load(params.preprocFile,'rgb_m','info')
load([params.maFile,'_heat.mat'])

%% Get Means and SEMs
n_mice                  = numel(unique(info.mouse));

% Frequency
[freq_mean, freq_sem]   = get_avg_trace(moving_freq,n_mice);

% Amplitude
[amp_mean, amp_sem]     = get_avg_trace(moving_amp,n_mice);

%% Plot with Shaded Error Bar

p1 = 'Frequency';
[~, ~, f1] = plot_moving_avg(freq_mean, freq_sem, rgb_m, p1);

p2 = 'Amplitude';
[~, ~, f2] = plot_moving_avg(amp_mean, amp_sem, rgb_m, p2);


% First call creates the figure
[h1, ax, f] = plot_shaded_error(freq_mean1, freq_sem1, color1, 'Frequency');

% Subsequent calls pass the same axis handle
[h2, ~, ~] = plot_shaded_error(freq_mean2, freq_sem2, color2, 'Frequency', ax);
[h3, ~, ~] = plot_shaded_error(freq_mean3, freq_sem3, color3, 'Frequency', ax);

% Add a legend
legend([h1.mainLine, h2.mainLine, h3.mainLine], {'Group 1', 'Group 2', 'Group 3'});
end
