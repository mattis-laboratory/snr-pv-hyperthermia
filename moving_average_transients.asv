%% Moving Average of Transients Properties
clear; close all

params  = transients_params();
load(params.detFile,'transients')
load(params.preprocFile,'events','zdff','info','rgb_m')

%% Get individual moving averages (frequency + amplitude)
for n = 1:size(transients,1)

    %% Pre-Seizure/ Heating
    % Get individual subject moving average from t0 to tUEO
    % Then flip each subjects data before ensemble average to align
    % pre-seizure time points

    % Input variables
    UEO      = events.zdff.UEO{n,1};
    BL       = events.zdff.BL{n,1};
    locs     = transients{n,2};
    P2Tamp   = transients{n,4};
    Fs       = zdff.fs;
    stepSize = params.stepSize*Fs;
    binWin   = params.binWin*Fs;

    startSteps = BL:stepSize:UEO;

    % Preallocate
    meanPreAmps   = zeros(size(startSteps));
    nPrePeaks     = zeros(size(startSteps));

    % Loop through windows
    for i = 1:length(startSteps)
        tStart = startSteps(i);
        tEnd   = tStart + binWin;

        % Find peaks in this window
        pks = locs >= tStart & locs < tEnd;

        % Compute metrics
        meanPreAmps(i)    = mean(P2Tamp(pks), 'omitnan');
        nPrePeaks(i)      = sum(pks);

        clear pks tStart tEnd
    end

    moving_amp{n,1}   = flip(meanPreAmps);
    moving_freq{n,1}  = flip(nPrePeaks./(stepSize/Fs)); % convert to Hz

    clearvars -except n params moving_* events zdff transients info rgb_m
end

%% Get Means and SEMs
n_mice                  = numel(unique(info.mouse));

% Frequency
[freq_mean, freq_sem]   = get_avg_trace(moving_freq);

% Amplitude
[amp_mean, amp_sem]     = get_avg_trace(moving_amp);

%% Plot Pre-Seizure Trace

[h, ax, f] = plot_moving_avg(freq_mean, freq_sem, rgb_m, 'Frequency');

%% Save
% Save as fig and png
saveas(f1, fileroot,'fig');   % Save as .fig file
saveas(f1, fileroot,'png');   % Save as .png file

delete(f1)

clear metric* h1 f1 ax1 truncAvg truncPost t1


%% Spearman correlation of time vs. moving average amp and freq
%[rho, pVal] = corr([1:length(metric_pre_mean)]',metric_pre_mean',"type","Spearman","tail","both");




%% Helpers

function [metric_mean, metric_sem] = get_avg_trace(metric, n_mice)

% Truncate all moving averages to shortest signal
minLen           = min(cellfun(@length,  metric(:,1)));
truncAvg         = cell2mat(cellfun(@(v) v(1:minLen),  ...
                    metric(:,1), 'UniformOutput', false));
% Get mean and SEM
metric_mean      = flip(nanmean(truncAvg, 1));
metric_sem       = flip(nanstd(truncAvg, 1)/sqrt(n_mice));
end
