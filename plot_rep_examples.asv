%% Example Traces
% Chandni Rana - University of Michigan (09/2024)
clc; clear; close all;

addpath(genpath('/nfs/turbo/umms-mattislab/Chandni/Code/export_fig-master'))
%% Load
params     = nostim_analysis_params();
load(params.preprocFile,'rgb_m','info','zdff','events')

%% Choose specific subject for each group for rep. examples
%figname = 'het_HT_seizure';
if strcmp(params.group,'WT_nsz') && strcmp(params.condition,'nostim')
    subject = 3;
elseif strcmp(params.group,'het_sz') && strcmp(params.condition,'nostim')
    subject = 6;
else 
    subject = 5;
end

%% Representative Baseline Transients (Fig. 2C)

for subject = 1:12

thisZdff = zdff.signal{subject};
tHT = zdff.t{subject};
BL = events.zdff.BL{subject}(1);

figure
plot(tHT,thisZdff,'Color',rgb_m,'LineWidth',2); box off;
xlim([0 tHT(BL)])

end

%%
thisZdff = zdff.signal{subject};
tHT = zdff.t{subject};
BL = events.zdff.BL{subject}(1);
EEC = events.zdff.EEC{subject}(1);
UEO = events.zdff.UEO{subject}(1);
OFF = events.zdff.OFF{subject}(1);
%
% eeg = het_eegs{subject};
% tEEG = getTime(eeg,Fs);
%
% subject = 4;
% zdff_PTZ = het_zdff_BL{subject};
% tPTZ = getTime(zdff_PTZ,Fs);
% UEO_PTZ = het_marks{subject}(3);
% eeg_PTZ = het_eegs{subject};


% Plot all panels
h = figure;
h.Position =  [184 325 549 370];

% tiledlayout(2,1)
% ax1=nexttile;
plot(tHT,thisZdff,'Color',rgb_m,'LineWidth',2); box off;
xline([tHT(EEC) tHT(EEC)],  'Color', 'k', 'LineStyle', '--', 'LineWidth', 2);
% xline([tHT(UEO) tHT(UEO)], 'Color', 'k', 'LineStyle', '--', 'LineWidth', 2);
ylabel('z-DF/F')
ax1 = gca;
ax1.FontSize = 16;
ax1.FontWeight = "bold";
xlim([tHT((EEC))-60 tHT(EEC)+120])
%xlim([tHT((UEO))-30 tHT(UEO)+30])

ylim([-5 20])

%%
x = xlim;
x = x(1);

tick_times =  x + (0:60:480);
tick_labels = arrayfun(@(t) num2str(t/60), 0:60:480, 'UniformOutput', false);

xticks(tick_times)
xticklabels(tick_labels)
xlabel('Time (min.)')

%% Figure 3B (transients during heating)
% late heating
xlim([tHT((EEC))-120 tHT(EEC)-60])

% early heating
xlim([tHT((EEC))-440 tHT(EEC)-380])



